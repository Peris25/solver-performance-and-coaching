# =============================================================================
# Solvit Performance Portal — environment configuration.
#
# Copy this file to `.env` and fill in real values BEFORE running:
#     cp .env.example .env
#     # edit .env
#     docker compose up -d
# =============================================================================

# ---- Database (PostgreSQL) ---------------------------------------------------
# These set up the Postgres container. The web service builds DATABASE_URL
# from them automatically — you don't need to set DATABASE_URL separately
# unless you're pointing at an external DB.
POSTGRES_DB=solvit
POSTGRES_USER=solvit
POSTGRES_PASSWORD=change-me-to-a-strong-password

# If you want to use an EXTERNAL postgres (e.g. Render, Supabase, RDS),
# uncomment this and comment out the POSTGRES_* vars above and the db
# service in docker-compose.yml:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname


# ---- Session / auth ---------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-generate-a-random-48-byte-secret

# Admin credentials. The hash is bcrypt. Generate with:
#   python -c "from app.auth import hash_password; print(hash_password('your-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$Cs7eb2AhZNkc0XbXJ1zG9.JgxflihUE8t/CmJUO3s4DEdZ7WWHrkG

# How long a login session lasts (hours)
SESSION_HOURS=24


# ---- Server tuning ----------------------------------------------------------
# Host port mapped to the container's 8000
PORT=8000

# gunicorn workers (2 is plenty for one admin)
WORKERS=2

# Comma-separated allowed CORS origins. Add your Render URL here.
ALLOWED_ORIGINS=http://localhost:8000,https://yourapp.onrender.com

# ---- Email (SMTP) — for sending coaching reports to solvers ----------------
# Leave SMTP_HOST blank to disable email entirely (buttons still appear but
# return a clean "email not configured" error so you can wire it up later).
#
# Gmail example (requires app password, not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=ops@yourcompany.co.ke
#   SMTP_PASSWORD=your-16-char-gmail-app-password
#   SMTP_USE_TLS=true
#   SMTP_FROM_EMAIL=ops@yourcompany.co.ke
#   SMTP_FROM_NAME=Solvit Operations
#
# Microsoft 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USERNAME=ops@yourcompany.co.ke
#   SMTP_PASSWORD=your-account-password
#   SMTP_USE_TLS=true
#   SMTP_FROM_EMAIL=ops@yourcompany.co.ke
#   SMTP_FROM_NAME=Solvit Operations
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Solvit Operations
